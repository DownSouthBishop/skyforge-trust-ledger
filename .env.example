# Atlas Autonomous Intelligence System — Environment Configuration
# Copy this file to .env and fill in all values before deployment.
# Variables prefixed with VITE_ are exposed to the frontend.
# All others are Supabase Edge Function secrets only.

# ── SUPABASE ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Supabase (Vite exposes these)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ── AI / LLM ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model selection (defaults shown)
ATLAS_MODEL=claude-sonnet-4-6
FAST_MODEL=claude-haiku-4-5-20251001

# ── TRADING BROKERS ───────────────────────────────────────
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice                        # practice | live

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_ENV=paper                          # paper | live

IBKR_CLIENT_ID=
IBKR_HOST=127.0.0.1
IBKR_PORT=7497

# ── MARKET DATA ───────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FRED_API_KEY=

# ── PAYMENTS (STRIPE) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SIGNAL_PRICE_ID=                   # $97/mo
STRIPE_INSTITUTIONAL_PRICE_ID=            # $497/mo
VITE_STRIPE_SIGNAL_PRICE_ID=
VITE_STRIPE_INSTITUTIONAL_PRICE_ID=

# ── EMAIL (RESEND) ────────────────────────────────────────
RESEND_API_KEY=
ADMIN_EMAIL=                              # Atlas sends RED alerts here

# ── PUBLISHING ────────────────────────────────────────────
GHOST_API_URL=                            # e.g. https://your-blog.ghost.io
GHOST_API_KEY=

# ── LEGAL ENTITY ─────────────────────────────────────────
ATLAS_ENTITY_NAME=                        # Wyoming LLC name
OWNER_LEGAL_NAME=                         # Full legal name of sole member

# ── PORTFOLIO POLICY ──────────────────────────────────────
RE_TARGET_MARKETS=                        # Comma-separated: "Austin TX,Nashville TN"
RE_MIN_CASH_ON_CASH=8                     # Minimum CoC% for RE deals
MAX_CAPITAL_PER_TRADE=200                 # Auto-execute threshold
MAX_CAPITAL_PER_RE_DEAL=50000
MAX_CAPITAL_PER_BUSINESS=25000

# ── DECISION THRESHOLDS ───────────────────────────────────
GREEN_DECISION_MAX_CAPITAL=200            # Auto-execute below this
ORANGE_DECISION_THRESHOLD=5000            # Require approval
RED_DECISION_THRESHOLD=25000             # Immediate notification

# ── REGULATORY ────────────────────────────────────────────
REGULATORY_BOUNDARY_MODE=STRICT           # STRICT | REVIEWED_AND_APPROVED

# ── TELEGRAM ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                       # @AtlasHUD bot token from @BotFather
TELEGRAM_CHAT_ID=                         # Your personal chat ID (e.g. 7695916981)

# ── FEATURE FLAGS ─────────────────────────────────────────
ENABLE_FELIX=false                        # Enable $FELIX DeFi monitoring
